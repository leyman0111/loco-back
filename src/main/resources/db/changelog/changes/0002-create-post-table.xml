<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="0002-create-post-table" author="loco-back">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="post"/>
            </not>
        </preConditions>

        <createTable tableName="post">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_post_author" references="users(id)"/>
            </column>
            <column name="state" type="INTEGER"/>
            <column name="created" type="TIMESTAMP"/>
            <column name="text" type="VARCHAR(255)"/>
            <column name="category" type="INTEGER"/>
            <column name="latitude" type="FLOAT4"/>
            <column name="longitude" type="FLOAT4"/>
            <column name="location_name" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
