<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="0004-create-reaction-table" author="loco-back">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="reaction"/>
            </not>
        </preConditions>

        <createTable tableName="reaction">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_reaction_author" references="users(id)"/>
            </column>
            <column name="type" type="INTEGER"/>
            <column name="post_id" type="BIGINT">
                <constraints foreignKeyName="fk_reaction_post" references="post(id)"/>
            </column>
            <column name="comment_id" type="BIGINT">
                <constraints foreignKeyName="fk_reaction_comment" references="comment(id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
