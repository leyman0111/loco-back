<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="0005-create-content-table" author="loco-back">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="content"/>
            </not>
        </preConditions>

        <createTable tableName="content">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="post_id" type="BIGINT">
                <constraints foreignKeyName="fk_content_post" references="post(id)"/>
            </column>
            <column name="type" type="INTEGER"/>
            <column name="origin" type="VARCHAR(255)"/>
            <column name="small" type="VARCHAR(255)"/>
            <column name="medium" type="VARCHAR(255)"/>
            <column name="large" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
